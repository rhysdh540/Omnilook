{
  "schemaVersion": 1,
  "id": "omnilook",
  "version": "${version}",

  "name": "${name}",
  "description": "${description}",
  "authors": ["rdh"],
  "icon": "omnilook.png",
  "contact": {
    "homepage": "${github}",
    "sources": "${github}",
    "issues": "${github}/issues"
  },

