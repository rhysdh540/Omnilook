  },
  "mixins": ["omnilook.mixins.json"],

  "depends": {
    "minecraft": [">=0.31.20100218-16"],
    "fabricloader": ">=0.15.0"
  },

  "jars": [
    { "file": "META-INF/ji.jar" }
  ]
}
